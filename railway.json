{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "command": "npm install && npm run build"
  },
  "deploy": {
    "startCommand": "bash start.sh",
 "healthcheckPath": "/up",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}