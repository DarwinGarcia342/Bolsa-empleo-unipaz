APP_NAME="Bolsa de Empleo UNIPAZ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ════════════════════════════════════════════════════════════════════════════
# BASE DE DATOS
# ════════════════════════════════════════════════════════════════════════════
# 
# ✅ OPCIÓN 1: SQLite (RECOMENDADO PARA DESARROLLO LOCAL)
# Archivo de base de datos: database/database.sqlite
# - Fácil de configurar
# - No requiere servidor externo
# - Ideal para desarrollo y pruebas
# 
# ✅ OPCIÓN 2: MySQL (PRODUCCIÓN)
# - Mejor rendimiento para múltiples usuarios
# - Requiere servidor MySQL instalado
# 
# ════════════════════════════════════════════════════════════════════════════

# --- SQLite (DEFAULT) ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_URL is opcional. Laravel puede usar este valor para configurar SQLite, MySQL o PostgreSQL desde una sola cadena.
# Ejemplo Railway para SQLite: DB_URL=sqlite:///app/database/database.sqlite

# --- MySQL (Descomenta para usar MySQL) ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bolsa_empleo_unipaz
# DB_USERNAME=root
# DB_PASSWORD=

# ════════════════════════════════════════════════════════════════════════════
# SESIÓN Y CACHÉ
# ════════════════════════════════════════════════════════════════════════════
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

# ════════════════════════════════════════════════════════════════════════════
# COLA DE TRABAJOS Y BROADCASTING
# ════════════════════════════════════════════════════════════════════════════
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ════════════════════════════════════════════════════════════════════════════
# ALMACENAMIENTO DE ARCHIVOS
# ════════════════════════════════════════════════════════════════════════════
FILESYSTEM_DISK=local

# ════════════════════════════════════════════════════════════════════════════
# CORREO ELECTRÓNICO
# ════════════════════════════════════════════════════════════════════════════
# Para desarrollo local, usa 'log' (los correos se guardan en logs)
# Para producción, configura SMTP con tus credenciales

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="bolsaempleo@unipaz.edu.co"
MAIL_FROM_NAME="${APP_NAME}"

# ════════════════════════════════════════════════════════════════════════════
# GOOGLE OAUTH (AUTENTICACIÓN CON GOOGLE)
# ════════════════════════════════════════════════════════════════════════════
# Instrucciones:
# 1. Ir a: https://console.cloud.google.com/
# 2. Crear un nuevo proyecto
# 3. Habilitar API de Google+ 
# 4. Crear credenciales OAuth 2.0 (Aplicación web)
# 5. Copiar Client ID y Client Secret aquí

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ════════════════════════════════════════════════════════════════════════════
# REDIS Y CACHÉ DISTRIBUIDO
# ════════════════════════════════════════════════════════════════════════════
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ════════════════════════════════════════════════════════════════════════════
# ALMACENAMIENTO EN LA NUBE (Opcional)
# ════════════════════════════════════════════════════════════════════════════
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE SEGURIDAD
# ════════════════════════════════════════════════════════════════════════════
BCRYPT_ROUNDS=12

